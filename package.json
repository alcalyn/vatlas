{
  "name": "vatlas",
  "version": "1.0.0",
  "description": "Resolve a business tax number (EU VAT number and national equivalents) to company information",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n api,console,site -c cyan,magenta,green \"npm:api:dev\" \"npm:console:dev\" \"npm:site:dev\"",
    "api:dev": "tsx watch src/server.ts",
    "console:dev": "tsx watch src/consoleServer.ts",
    "site:dev": "npm --prefix site run dev",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "console": "node dist/consoleServer.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "db:setup": "prisma migrate deploy",
    "import": "tsx src/cli/import.ts",
    "source": "tsx src/cli/source.ts",
    "benchmark": "tsx src/cli/benchmark.ts",
    "compare": "tsx src/cli/compare.ts",
    "unpair": "tsx src/cli/unpair.ts",
    "sanitize": "tsx src/cli/sanitize.ts",
    "collapse": "tsx src/cli/collapse.ts",
    "stats": "tsx src/cli/stats.ts",
    "country-examples": "tsx src/cli/countryExamples.ts",
    "i18n": "tsx src/cli/i18n.ts",
    "stripe:webhook": "tsx src/cli/stripeWebhook.ts",
    "retention": "tsx src/cli/retention.ts",
    "monitors": "tsx src/cli/monitors.ts",
    "lookups:async": "tsx src/cli/asyncLookups.ts",
    "audit:prune": "tsx src/cli/auditPrune.ts",
    "email:test": "tsx src/cli/testEmail.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "prisma migrate dev"
  },
  "author": "Julien Maulny",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "hyparquet": "^1.30.0",
    "hyparquet-compressors": "^1.1.1",
    "i18next": "^26.4.1",
    "mysql2": "^3.15.4",
    "nodemailer": "^9.0.5",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "stripe": "^22.5.0",
    "yauzl": "^3.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/yauzl": "^3.4.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "hyparquet-writer": "^0.16.9",
    "prettier": "^3.9.10",
    "prisma": "^7.10.0",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.4"
  }
}
