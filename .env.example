# API HTTP port (the console uses CONSOLE_PORT).
PORT=3000
LOG_LEVEL=info
LOG_FORMAT=pretty

# Number of reverse proxies in front of the app, passed to Express `trust proxy` to read the
# client IP from `X-Forwarded-For`. Leave unset (0) in development.
#
# In production it must match the real hop count. Trusting one hop too many lets a client spoof
# its IP and bypass the per-IP limits. One nginx on the same host means 1.
# TRUST_PROXY_HOPS=1

# MySQL 8.0 or newer (the history collapse uses LAG/LEAD). Read by the app and the prisma CLI.
DATABASE_URL="mysql://root:vatlas@127.0.0.1:3306/vatlas"

# VIES, the fallback for EU member states. Set VIES_REQUESTER_VAT before enabling it.
VIES_ENABLED=false

# Your own VAT number, sent with every VIES call. VIES only returns a consultation number (the
# proof that the check was made) when a requester is named. It is published as `meta.proof`.
#
# Required when VIES_ENABLED=true: the process refuses to start without it. VIES rejects unknown
# numbers with INVALID_REQUESTER_INFO, so use a real, registered one.
VIES_REQUESTER_VAT=

VIES_TIMEOUT_MS=10000

# Age after which a live source is asked again. Bulk sources are not affected.
LIVE_MAX_AGE_DAYS=7

# Where bulk files are downloaded and cached.
DOWNLOAD_DIR=./.cache


# Public URLs, used in emails, sample commands and by the site build.
#
# The site build refuses localhost values, since it bakes them into the published HTML. Use
# `npm run dev` to preview the site locally.
SITE_URL=https://vatlas.dev
API_BASE_URL=https://api.vatlas.dev
# Target of the verification and reset links. Must be the URL the browser reaches, since the link
# sets the session cookie.
CONSOLE_BASE_URL=https://console.vatlas.dev
# Shown on the site and in its structured data.
CONTACT_EMAIL=contact@vatlas.dev
# Support links. The Pro invite is only shown in the console to Pro accounts (create another invite link that gives pro roles).
DISCORD_INVITE_URL=https://discord.gg/R28nneW5xU
DISCORD_PRO_INVITE_URL=https://discord.gg/R28nneW5xU

# Umami analytics for the website only (never the console).
# Leave UMAMI_WEBSITE_ID empty to disable tracking: no script tag is emitted. The script is
# cookieless, which is why the site has no consent banner. A tool that sets cookies would make the
# privacy policy wrong.
#
#   UMAMI_WEBSITE_ID   the id from Umami -> Settings -> Websites.
#   UMAMI_SCRIPT_URL   the Umami Cloud region:
#                        https://cloud.umami.is/script.js  (default)
#                        https://eu.umami.is/script.js     (EU region)
#                      or your own origin if you self-host.
#   UMAMI_DOMAINS      optional, comma-separated hostnames allowed to report, so local builds
#                      and copies of the site stay out of the statistics.
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
UMAMI_DOMAINS=

# Console HTTP port.
CONSOLE_PORT=3001
SESSION_TTL_DAYS=30

# Secret mixed into every key, session and email link hash, so a stolen database dump holds no
# usable keys. Set a long random value in production (`openssl rand -hex 32`). Changing it logs
# everyone out and invalidates every API key.
TOKEN_PEPPER=development-pepper

# Monthly quota per account. Both plans call the same endpoints and get the same fields.
# The site build reads these too, so the pricing page always matches.
PLAN_FREE_QUOTA=100
PLAN_PRO_QUOTA=5000

# Audit trail retention: a number of rows on the free plan, a number of days on the paid plan.
# Applied nightly by `npm run retention`. The privacy policy quotes these figures in plain text:
# update site/src/privacy/{en,fr}/index.html when changing them.
AUDIT_FREE_KEEP=3
AUDIT_PRO_DAYS=730

# How many companies an account may monitor. Monitors are not metered. Read by the site build too.
MONITOR_FREE_MAX=3
MONITOR_PRO_MAX=200

# Callback delivery, used by monitors and async lookups. Every attempt is recorded and shown in the
# console.
CALLBACK_TIMEOUT_MS=10000
CALLBACK_RETRIES=3
# Allow callback URLs on localhost, RFC 1918 or link-local addresses. Keep false in production,
# otherwise customers can make the server call internal services. Set to true locally to test
# against a receiver on localhost.
CALLBACK_ALLOW_PRIVATE_URLS=false

# Async lookups: how long one is retried before it fails (and its credit is refunded), and the
# maximum delay between attempts. The delay doubles from ten minutes.
ASYNC_LOOKUP_MAX_DAYS=7
ASYNC_LOOKUP_MAX_BACKOFF_MS=86400000

# Email. The defaults point at the Mailpit container (http://localhost:8025).
# In production, use a real relay with SPF, DKIM and DMARC set up on the sending domain.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Vatlas <noreply@vatlas.dev>"

# Stripe. Optional: when empty, the console hides the upgrade button. Leave them empty rather than
# filling a placeholder. Their format is checked at startup.
#
#   STRIPE_SECRET_KEY      sk_test_... or sk_live_... (rk_... restricted keys work too).
#                          Stripe dashboard -> Developers -> API keys.
#
#   STRIPE_WEBHOOK_SECRET  whsec_...
#                          Printed by `stripe listen --forward-to localhost:3001/stripe/webhook`
#                          in development, shown under Developers -> Webhooks in production.
#
#                          The endpoint is POST /stripe/webhook on the console, not the API.
#                          Select these three events (others are recorded and ignored):
#
#                            customer.subscription.created   grants the paid plan
#                            customer.subscription.updated   status changes and portal cancellation
#                            customer.subscription.deleted   back to the free plan
#
#                          Set the endpoint API version to 2026-07-29.dahlia, the version the SDK
#                          is pinned to. Versions before 2025-03-31.basil put current_period_end
#                          on the subscription instead of its items, and the dates end up null.
#
#                          To match production in development:
#                          `stripe listen --events customer.subscription.created,customer.subscription.updated,customer.subscription.deleted --forward-to localhost:3001/stripe/webhook`.
#
#   STRIPE_PRICE_PRO       price_...
#                          The id of a recurring monthly price, not the product id (prod_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=


# Registers that are free but need an account. All optional: without credentials the source is
# skipped and the lookup falls back to VIES.
#
# How to get each account: documentation/credentials.md.

# Belgium - KBO / BCE open data.
KBO_USER=
KBO_PASSWORD=

# Denmark - CVR system-to-system access.
CVR_USER=
CVR_PASSWORD=

# Croatia - Sudski registar open data.
SUDREG_CLIENT_ID=
SUDREG_CLIENT_SECRET=

# Greece - AADE RgWsPublic2 (requires a TAXISnet account). Asked before VIES.
AADE_USER=
AADE_PASSWORD=

# Greece - GEMI open data. Asked after VIES, because its search by AFM is slow (~2.3 s).
GEMI_API_KEY=

# New Zealand - NZBN API. Without it, New Zealand numbers have no source at all.
NZBN_API_KEY=
